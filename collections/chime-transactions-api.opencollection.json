{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chime Partner Authentication Transactions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.chimebank.com/chime/v1/users/:id/accounts/:account_id/transactions",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the Chime user"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the bank account"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated results"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of transactions per page"
              },
              {
                "name": "from_date",
                "value": "",
                "type": "query",
                "description": "Filter transactions from this date (ISO 8601)"
              },
              {
                "name": "to_date",
                "value": "",
                "type": "query",
                "description": "Filter transactions to this date (ISO 8601)"
              }
            ]
          },
          "docs": "Resource for accessing transactions for the given bank account."
        }
      ]
    }
  ],
  "bundled": true
}