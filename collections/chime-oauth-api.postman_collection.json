          "name": "Initiate OAuth 2.0 Authorization",
          "request": {
            "name": "Initiate OAuth 2.0 Authorization",
            "description": {
              "content": "Initiates the OAuth 2.0 Authorization Code Flow with optional PKCE support. Redirects the user to the Chime authorization page.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) Must be \"code\" for Authorization Code Flow"
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Your application's client identifier"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) URI to redirect to after authorization"
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Space-separated list of requested scopes"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Opaque value to maintain state between request and callback"
                },
                {
                  "disabled": false,
                  "key": "code_challenge",
                  "value": "<string>",
                  "description": "PKCE code challenge (Base64-URL-encoded SHA-256 hash of the code verifier)"
                },
                {
                  "disabled": false,
                  "key": "code_challenge_method",
                  "value": "<string>",
                  "description": "Method used to generate the code challenge"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
